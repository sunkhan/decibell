+impl CosmicTextSystem {
+    /// Starts with an empty font database, like [`Self::new_without_system_fonts`], and indexes
+    /// the installed fonts the first time a family is requested that no added font provides.
+    ///
+    /// Indexing every installed font costs startup time, and cosmic-text then walks the whole
+    /// index for each new (family, weight, style) it shapes. An application that embeds its
+    /// fonts pays neither as long as it names only those; fallback for characters they lack is
+    /// then the application's job (it can add a covering font with `add_fonts`).
+    pub fn new_with_deferred_system_fonts(system_font_fallback: &str) -> Self {
+        let text_system = Self::new_without_system_fonts(system_font_fallback);
+        {
+            let mut state = text_system.0.write();
+            state.system_fonts_deferred = true;
+            // The same locale `FontSystem::new` would have picked; it steers CJK fallback.
+            let locale = std::env::var("LC_ALL")
+                .or_else(|_| std::env::var("LC_CTYPE"))
+                .or_else(|_| std::env::var("LANG"))
+                .ok()
+                .and_then(|value| value.split('.').next().map(|tag| tag.replace('_', "-")))
+                .filter(|tag| !tag.is_empty() && tag != "C" && tag != "POSIX")
+                .unwrap_or_else(|| "en-US".to_string());
+            let database = cosmic_text::fontdb::Database::new();
+            state.font_system = FontSystem::new_with_locale_and_db(locale, database);
+        }
+        text_system
+    }
+}
