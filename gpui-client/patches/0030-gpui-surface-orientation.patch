+/// texture coordinates), never by copying pixels; the fit works on the turned size.
+///
+/// The value is three bits: with `p` a point of the drawn picture (0..1, y down), the stored
+/// picture is sampled at `p` with x and y exchanged if [`Self::TRANSPOSE`] is set, then with x
+/// mirrored if [`Self::FLIP_X`] and y mirrored if [`Self::FLIP_Y`].
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub struct SurfaceOrientation(pub u8);
+
+impl SurfaceOrientation {
+    pub const FLIP_X: u8 = 1;
+    pub const FLIP_Y: u8 = 2;
+    pub const TRANSPOSE: u8 = 4;
+
+    pub const IDENTITY: Self = Self(0);
+    /// The stored picture is drawn turned a quarter clockwise.
+    pub const ROTATE_90: Self = Self(Self::TRANSPOSE | Self::FLIP_Y);
+    pub const ROTATE_180: Self = Self(Self::FLIP_X | Self::FLIP_Y);
