 }
 
+impl LineLayoutIndex {
+    /// What was at `from` in the previous frame is at `to` in this one: moves this index,
+    /// which lies at or after `from`, by the same distance.
+    pub(crate) fn rebase(&mut self, from: &Self, to: &Self) {
+        self.lines_index = self.lines_index + to.lines_index - from.lines_index;
+        self.wrapped_lines_index =
+            self.wrapped_lines_index + to.wrapped_lines_index - from.wrapped_lines_index;
+        // The font generation stays the one the range was recorded under: after a change
+        // of it nothing was replayed, and `reuse_layouts` refuses the range for good.
+    }
+}
