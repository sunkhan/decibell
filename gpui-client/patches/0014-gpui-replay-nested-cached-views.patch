+    pub(crate) fn rebase(&mut self, from: &Self, to: &Self) {
+        let moved = |index: &mut usize, from: usize, to: usize| *index = *index + to - from;
+        moved(&mut self.hitboxes_index, from.hitboxes_index, to.hitboxes_index);
+        moved(&mut self.tooltips_index, from.tooltips_index, to.tooltips_index);
