+/// Changes the parameters a Vulkan device is created with: device extensions, extra queues and
+/// feature structures the application needs on the device GPUI renders with (hardware video
+/// decode on the renderer's own `VkDevice`, for one). Must only add what the adapter supports.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+pub type VulkanDeviceHook = dyn for<'arg, 'pnext, 'this> Fn(
+        &wgpu::Adapter,
+        &mut wgpu::hal::vulkan::CreateDeviceCallbackArgs<'arg, 'pnext, 'this>,
+    ) + Send
+    + Sync;
+
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+static VULKAN_DEVICE_HOOK: std::sync::OnceLock<Box<VulkanDeviceHook>> = std::sync::OnceLock::new();
+
+/// Installs the hook every Vulkan device creation runs (including after a device loss). Call
+/// before the first window opens; a second call is ignored and returns false.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+pub fn set_vulkan_device_hook(hook: Box<VulkanDeviceHook>) -> bool {
+    VULKAN_DEVICE_HOOK.set(hook).is_ok()
+}
+
+static DEVICE_QUEUE_LOCK: Mutex<()> = Mutex::new(());
+
+/// Held by the renderer around every use of its device's queues: submitting, presenting, and
+/// configuring or releasing a surface (wgpu waits for the whole device to idle there, which
+/// Vulkan only allows while no thread is submitting to any of the device's queues).
+///
+/// An application that submits raw commands to queues of the renderer's device from other
+/// threads (hardware video decode, see [`set_vulkan_device_hook`]) holds it around each of its
+/// submissions too, on whichever queue, and never across anything that waits on the GPU.
+pub fn device_queue_lock() -> &'static Mutex<()> {
+    &DEVICE_QUEUE_LOCK
+}
+
+#[cfg(not(target_family = "wasm"))]
+static SHARED_CONTEXT: Mutex<Option<WgpuContext>> = Mutex::new(None);
+
+/// The context every window of this process renders with: the device to create textures on and
+/// the queue to upload with, for content handed to the renderer as a [`crate::WgpuSurface`].
+/// `None` until the first window exists. A device loss replaces it (compare `device`).
+#[cfg(not(target_family = "wasm"))]
+pub fn shared_context() -> Option<WgpuContext> {
+    SHARED_CONTEXT.lock().clone()
+}
