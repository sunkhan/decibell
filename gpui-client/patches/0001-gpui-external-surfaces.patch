+/// A GPU image owned by the application (a decoded video picture, a camera frame) that the
+/// platform renderer composites in scene order, clipped and rounded like any other primitive.
+///
+/// The scene only carries the handle. What it must be is the platform renderer's business
+/// (`gpui_wgpu::WgpuSurface` for the wgpu renderer), and the renderer reads the image it
+/// currently holds when it draws, not when the element paints: presenting the retained scene
+/// again ([`crate::Window::request_present`]) shows a newer image without painting anything.
+#[derive(Clone)]
+pub struct ExternalSurface(pub std::sync::Arc<dyn std::any::Any + Send + Sync>);
+
+impl ExternalSurface {
+    /// Wraps a renderer-specific surface object.
+    pub fn new<T: std::any::Any + Send + Sync>(surface: std::sync::Arc<T>) -> Self {
+        Self(surface)
+    }
+}
+
+impl Debug for ExternalSurface {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "ExternalSurface({:p})", std::sync::Arc::as_ptr(&self.0))
+    }
 }
 
