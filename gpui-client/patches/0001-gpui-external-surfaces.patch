+//! Images the application owns on the GPU, drawn by the wgpu renderer as scene surfaces.
+//!
+//! An element paints a [`WgpuSurface`] (wrapped in a `gpui::ExternalSurface`) with
+//! `Window::paint_external_surface`. The application hands the surface new pictures from any
+//! thread with [`WgpuSurface::set_frame`]; the renderer takes the newest one each time it draws
+//! the scene, so a new picture costs a present of the retained scene (`Window::request_present`)
+//! and no layout or paint.
+
+use parking_lot::Mutex;
+use std::any::Any;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+/// The two plane textures of a 4:2:0 picture, on the renderer's device: luma (one channel) and
+/// interleaved chroma (two channels, half size). Views of ordinary `R8Unorm` / `Rg8Unorm`
+/// textures or of the planes of a multi-planar one.
+///
+/// Long-lived: the renderer caches a bind group per `Arc<WgpuSurfacePlanes>`, so a decoder
+/// should cycle through a small fixed set of these instead of making one per picture.
+pub struct WgpuSurfacePlanes {
+    pub luma: wgpu::TextureView,
+    pub chroma: wgpu::TextureView,
+}
+
+/// How a picture's Y'CbCr samples become R'G'B'.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SurfaceMatrix {
+    Bt601,
+    Bt709,
+    Bt2020,
+}
+
+/// A picture's colour description.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SurfaceColor {
+    pub matrix: SurfaceMatrix,
+    /// Full range (0..255) rather than limited (16..235 / 16..240).
+    pub full_range: bool,
+    /// Added to the chroma sampling position, in chroma texels. [0.0, 0.0] is right for chroma
+    /// sited at the centre of each 2x2 luma block (what sampling both planes at the same
+    /// coordinate assumes); "left" siting, the H.264 / HEVC / AV1 default, is [0.25, 0.0].
+    pub chroma_offset: [f32; 2],
+}
+
+impl Default for SurfaceColor {
+    fn default() -> Self {
+        Self {
+            matrix: SurfaceMatrix::Bt709,
+            full_range: false,
+            chroma_offset: [0.0, 0.0],
+        }
+    }
+}
+
+impl SurfaceColor {
+    /// Rows of the matrix taking (Y', Cb, Cr, 1) as sampled (0..1) to gamma-encoded R'G'B'.
+    /// GPUI's targets are non-sRGB formats holding gamma-encoded colour, so the result is
+    /// written as is.
+    pub fn ycbcr_to_rgb_rows(&self) -> [[f32; 4]; 3] {
+        let (kr, kb) = match self.matrix {
+            SurfaceMatrix::Bt601 => (0.299, 0.114),
+            SurfaceMatrix::Bt709 => (0.2126, 0.0722),
+            SurfaceMatrix::Bt2020 => (0.2627, 0.0593),
+        };
+        let kg = 1.0 - kr - kb;
+        // Scale and offset from the stored code values to Y' in 0..1 and Cb / Cr in -0.5..0.5.
+        let (y_scale, y_offset, c_scale) = if self.full_range {
+            (1.0f32, 0.0f32, 1.0f32)
+        } else {
+            (255.0 / 219.0, 16.0 / 255.0, 255.0 / 224.0)
+        };
+        let c_offset = 128.0 / 255.0;
+        let r_cr = 2.0 * (1.0 - kr);
+        let b_cb = 2.0 * (1.0 - kb);
+        let g_cb = -b_cb * kb / kg;
+        let g_cr = -r_cr * kr / kg;
+        let row = |cb: f32, cr: f32| {
+            let cb = cb * c_scale;
+            let cr = cr * c_scale;
+            [
+                y_scale,
+                cb,
+                cr,
+                -y_scale * y_offset - (cb + cr) * c_offset,
+            ]
+        };
+        [row(0.0, r_cr), row(g_cb, g_cr), row(b_cb, 0.0)]
+    }
+}
+
+/// One picture, ready to be sampled: every write to its planes has completed.
+pub struct WgpuSurfaceFrame {
+    pub planes: Arc<WgpuSurfacePlanes>,
+    pub color: SurfaceColor,
+    /// Dropped once no scene shows the picture and every submission sampling it has finished on
+    /// the GPU. A decoder puts a token here to learn when it may overwrite the planes.
+    pub in_use: Option<Box<dyn Any + Send + Sync>>,
+}
+
+/// A place in the scene that shows the newest picture it was given.
+#[derive(Default)]
+pub struct WgpuSurface {
+    /// The newest picture and its sequence number (1-based count of pictures set).
+    latest: Mutex<(u64, Option<Arc<WgpuSurfaceFrame>>)>,
+    last_drawn: AtomicU64,
+    pictures_drawn: AtomicU64,
+    draws: AtomicU64,
+}
+
+impl WgpuSurface {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self::default())
+    }
+
+    /// Replaces the picture. Callable from any thread; the caller then asks the window that
+    /// shows the surface for a present (`Window::request_present`, on the main thread).
+    pub fn set_frame(&self, frame: Arc<WgpuSurfaceFrame>) {
+        let mut latest = self.latest.lock();
+        latest.0 += 1;
+        latest.1 = Some(frame);
+    }
+
+    /// Stops showing a picture (the surface draws nothing).
+    pub fn clear(&self) {
+        self.latest.lock().1 = None;
+    }
+
+    /// How many distinct pictures reached a rendered frame.
+    pub fn pictures_drawn(&self) -> u64 {
+        self.pictures_drawn.load(Ordering::Relaxed)
+    }
+
+    /// How many rendered frames drew this surface (a picture drawn again counts again).
+    pub fn draws(&self) -> u64 {
+        self.draws.load(Ordering::Relaxed)
+    }
+
+    /// The picture to draw now. Called by the renderer once per surface per frame.
+    pub(crate) fn acquire(&self) -> Option<Arc<WgpuSurfaceFrame>> {
+        let (sequence, frame) = {
+            let latest = self.latest.lock();
+            (latest.0, latest.1.clone()?)
+        };
+        self.draws.fetch_add(1, Ordering::Relaxed);
+        if self.last_drawn.swap(sequence, Ordering::Relaxed) != sequence {
+            self.pictures_drawn.fetch_add(1, Ordering::Relaxed);
+        }
+        Some(frame)
+    }
+}
