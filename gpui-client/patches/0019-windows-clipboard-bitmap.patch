+/// A packed DIB (`CF_DIB`): a `BITMAPINFOHEADER` (40 bytes, 32 bits per pixel, `BI_RGB`, bottom-up
+/// rows) followed by the pixels as BGRA. Alpha is kept in the fourth byte; programs that ignore it
+/// see the colours.
+fn convert_to_dib(bytes: &[u8], format: ImageFormat) -> Option<Vec<u8>> {
+    let img_format = gpui_to_image_format(format)?;
+    let image = image::load_from_memory_with_format(bytes, img_format)
+        .map_err(|e| log::warn!("Failed to decode image for DIB conversion: {e}"))
+        .ok()?
+        .to_rgba8();
+    let (width, height) = image.dimensions();
+    let pixel_bytes = width.checked_mul(height)?.checked_mul(4)?;
+    let mut dib = Vec::with_capacity(40 + pixel_bytes as usize);
+    dib.extend_from_slice(&40u32.to_le_bytes()); // biSize
+    dib.extend_from_slice(&i32::try_from(width).ok()?.to_le_bytes()); // biWidth
+    dib.extend_from_slice(&i32::try_from(height).ok()?.to_le_bytes()); // biHeight: > 0, bottom-up
+    dib.extend_from_slice(&1u16.to_le_bytes()); // biPlanes
+    dib.extend_from_slice(&32u16.to_le_bytes()); // biBitCount
+    dib.extend_from_slice(&0u32.to_le_bytes()); // biCompression: BI_RGB
+    dib.extend_from_slice(&pixel_bytes.to_le_bytes()); // biSizeImage
+    dib.extend_from_slice(&0i32.to_le_bytes()); // biXPelsPerMeter
+    dib.extend_from_slice(&0i32.to_le_bytes()); // biYPelsPerMeter
+    dib.extend_from_slice(&0u32.to_le_bytes()); // biClrUsed
+    dib.extend_from_slice(&0u32.to_le_bytes()); // biClrImportant
+    for row in image.rows().rev() {
+        for pixel in row {
+            let [r, g, b, a] = pixel.0;
+            dib.extend_from_slice(&[b, g, r, a]);
+        }
+    }
+    Some(dib)
+}
