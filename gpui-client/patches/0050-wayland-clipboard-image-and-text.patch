+    /// What the offer holds, as one item: its picture first (when it offers one), then its text
+    /// (when it offers that too). A browser's "Copy image" offers both; reading the text first
+    /// and stopping there (as GPUI did) lost the picture. Each reader takes the entry it wants:
+    /// a field that attaches pictures the image, a text field the text (Chromium's paste).
+    fn read_image_and_text(&self, connection: &Connection) -> Option<ClipboardItem> {
+        let image = self.read_image(connection);
+        let text = self.read_text(connection);
+        match (image, text) {
+            (Some(mut image), Some(text)) => {
+                image.entries.extend(text.entries);
+                Some(image)
+            }
+            (image, text) => image.or(text),
+        }
+    }
