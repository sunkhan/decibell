+/// What the thread's keyboard layout types for the key at scan code `code` with no modifier held;
+/// a dead key gives its accent (Windows puts the spacing form in the buffer). `ToUnicodeEx` with
+/// flag 4 leaves the keyboard's dead-key state alone (Windows 10 1607 and later).
+pub(crate) fn key_text(code: gpui::KeyCode) -> Option<String> {
+    let gpui::KeyCode::Windows(scan) = code else {
+        return None;
+    };
+    // SAFETY: plain calls with values and buffers that live across them; the layout handle is
+    // this thread's (the UI thread's, the one keys are typed into).
+    unsafe {
+        let layout = GetKeyboardLayout(0);
+        let vkey = MapVirtualKeyExW(u32::from(scan), MAPVK_VSC_TO_VK_EX, Some(layout));
+        if vkey == 0 {
+            return None;
+        }
+        let state = [0u8; 256];
+        let mut buffer = [0u16; 8];
+        let written = ToUnicodeEx(vkey, u32::from(scan), &state, &mut buffer, 4, Some(layout));
+        let length = (written.unsigned_abs() as usize).min(buffer.len());
+        let text = String::from_utf16(&buffer[..length]).ok()?;
+        (!text.is_empty() && !text.chars().any(char::is_control)).then_some(text)
+    }
+}
