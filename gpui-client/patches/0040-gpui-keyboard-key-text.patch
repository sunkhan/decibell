+/// What `code` types in `state`'s effective layout with no modifier held, or a dead key's accent
+/// (spacing form): the key's label.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+pub(super) fn key_text_from_xkb(state: &State, code: gpui::KeyCode) -> Option<String> {
+    let gpui::KeyCode::Evdev(evdev) = code else {
+        return None;
+    };
+    let keymap = state.get_keymap();
+    let layout = state.serialize_layout(xkbcommon::xkb::STATE_LAYOUT_EFFECTIVE);
+    let mut plain = State::new(&keymap);
+    plain.update_mask(0, 0, 0, 0, 0, layout);
+    let keycode = Keycode::from(u32::from(evdev) + 8);
+    let text = plain.key_get_utf8(keycode);
+    if !text.is_empty() && !text.chars().any(char::is_control) {
+        return Some(text);
+    }
+    let accent = match plain.key_get_one_sym(keycode) {
+        Keysym::dead_grave => '`',
+        Keysym::dead_acute => '\u{b4}',
+        Keysym::dead_circumflex => '^',
+        Keysym::dead_tilde => '~',
+        Keysym::dead_macron => '\u{af}',
+        Keysym::dead_breve => '\u{2d8}',
+        Keysym::dead_abovedot => '\u{2d9}',
+        Keysym::dead_diaeresis => '\u{a8}',
+        Keysym::dead_abovering => '\u{b0}',
+        Keysym::dead_doubleacute => '\u{2dd}',
+        Keysym::dead_caron => '\u{2c7}',
+        Keysym::dead_cedilla => '\u{b8}',
+        Keysym::dead_ogonek => '\u{2db}',
+        _ => return None,
+    };
+    Some(accent.to_string())
+}
