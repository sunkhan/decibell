+/// Creates the instance, the window's surface on it and the context that renders to it.
+///
+/// Vulkan is tried on its own first, so that a machine where a Vulkan GPU can configure the
+/// surface never initialises OpenGL (see [`WgpuContext::vulkan_instance`]). Only if no discrete
+/// or integrated Vulkan GPU works is the search repeated over Vulkan and OpenGL together, with
+/// every adapter type. The first pass accepts exactly the adapters the second would rank
+/// above all OpenGL ones, so the adapter chosen is the same either way.
+#[cfg(not(target_family = "wasm"))]
+fn create_context_and_surface<W>(
+    window: &W,
+    raw_window_handle: raw_window_handle::RawWindowHandle,
+    config: &WgpuSurfaceConfig,
+    compositor_gpu: Option<CompositorGpuHint>,
+    reject_software: bool,
+) -> anyhow::Result<(WgpuContext, wgpu::Surface<'static>)>
+where
+    W: HasDisplayHandle + std::fmt::Debug + Send + Sync + Clone + 'static,
+{
+    let instance = WgpuContext::vulkan_instance(Some(Box::new(window.clone())));
+    match create_surface(&instance, raw_window_handle).and_then(|surface| {
+        let context = WgpuContext::new_hardware_only(
+            instance,
+            &surface,
+            config,
+            compositor_gpu,
+            reject_software,
+        )?;
+        Ok((context, surface))
+    }) {
+        Ok(created) => return Ok(created),
+        Err(error) => {
+            log::info!("No Vulkan GPU can drive this window ({error:#}); trying OpenGL as well")
+        }
+    }
+
+    let instance = WgpuContext::instance(Some(Box::new(window.clone())));
+    let surface = create_surface(&instance, raw_window_handle)
+        .map_err(|e| anyhow::anyhow!("Failed to create surface: {e}"))?;
+    let context = if reject_software {
+        WgpuContext::new_rejecting_software(instance, &surface, config, compositor_gpu)?
+    } else {
+        WgpuContext::new(instance, &surface, config, compositor_gpu)?
+    };
+    Ok((context, surface))
+}
