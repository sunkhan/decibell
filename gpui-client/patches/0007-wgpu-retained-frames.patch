+/// A frame read back from the GPU ([`capture_next_surface_frame`]).
+#[cfg(not(target_family = "wasm"))]
+pub struct CapturedFrame {
+    pub width: u32,
+    pub height: u32,
+    pub format: wgpu::TextureFormat,
+    /// `width * height * 4` bytes, rows top to bottom, in `format`'s channel order.
+    pub pixels: Vec<u8>,
+    /// The frame was encoded from the previous frame's draw list.
+    pub reused: bool,
+}
+
+#[cfg(not(target_family = "wasm"))]
+struct CaptureRequest {
+    rebuild: bool,
+    sender: std::sync::mpsc::Sender<CapturedFrame>,
+}
+
+#[cfg(not(target_family = "wasm"))]
+static CAPTURE: parking_lot::Mutex<Option<CaptureRequest>> = parking_lot::Mutex::new(None);
+#[cfg(not(target_family = "wasm"))]
+static CAPTURE_PENDING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Asks for a copy of the next frame a window draws of a scene with external surfaces: that
+/// frame is also rendered into an offscreen texture of the window's format and size, by the
+/// same code and with the same pictures, and read back. `rebuild`: write the scene to the GPU
+/// again for it even if the previous frame's draw list could be reused. For tests that compare
+/// the two paths; the read-back waits for the GPU on the render thread.
+#[cfg(not(target_family = "wasm"))]
+pub fn capture_next_surface_frame(rebuild: bool) -> std::sync::mpsc::Receiver<CapturedFrame> {
+    let (sender, receiver) = std::sync::mpsc::channel();
+    *CAPTURE.lock() = Some(CaptureRequest { rebuild, sender });
+    CAPTURE_PENDING.store(true, std::sync::atomic::Ordering::Release);
+    receiver
+}
