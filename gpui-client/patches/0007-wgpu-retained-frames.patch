+/// What was built on the GPU for the scene drawn last: its instance data (in `instance_data`,
+/// written once), the bind groups over it and the list of draw calls. Every frame is encoded
+/// from the list. A frame of the same scene at the same size reuses all of it: nothing is
+/// written or created for the scene, only the pass is recorded again, with the pictures the
+/// scene's external surfaces hold by then (`Window::request_present` for a video frame).
+#[derive(Default)]
+struct RetainedFrame {
+    /// The list belongs to this scene, size and atlas state and may be drawn again as it is.
+    /// Only ever set for scenes with external surfaces: nothing else presents an unchanged
+    /// scene often enough to matter.
+    reusable: bool,
+    scene_version: u64,
+    size: Size<DevicePixels>,
+    atlas_revision: u64,
+    draws: Vec<RetainedDraw>,
+}
+
+/// How the frames of this process were drawn, for measuring the reuse of retained frames.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct FrameStats {
+    /// Frames whose scene was written to the GPU (instance data, bind groups, draw list).
+    pub built: u64,
+    /// Frames encoded from the previous frame's draw list (same scene, new surface pictures).
+    pub reused: u64,
+    /// Time spent in `WgpuRenderer::draw` for each kind, nanoseconds (acquire, encode, submit
+    /// and present; not the GPU's time).
+    pub built_ns: u64,
+    pub reused_ns: u64,
+}
+
+static FRAME_REUSE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+static FRAMES_BUILT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static FRAMES_REUSED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static BUILT_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static REUSED_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// Whether a frame of an unchanged scene reuses what the previous frame built (the default).
+/// Off: every frame writes its scene to the GPU again, as before retained frames existed. For
+/// measuring the difference and for comparing the two paths' output.
+pub fn set_frame_reuse(enabled: bool) {
+    FRAME_REUSE.store(enabled, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// See [`FrameStats`]. Sums over every window of the process since it started.
+pub fn frame_stats() -> FrameStats {
+    let load = |counter: &std::sync::atomic::AtomicU64| {
+        counter.load(std::sync::atomic::Ordering::Relaxed)
+    };
+    FrameStats {
+        built: load(&FRAMES_BUILT),
+        reused: load(&FRAMES_REUSED),
+        built_ns: load(&BUILT_NS),
+        reused_ns: load(&REUSED_NS),
+    }
+}
