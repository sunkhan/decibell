+// What follows the matrix for a picture that is not ordinary SDR video (`SurfaceTransfer`:
+// 1 PQ, 2 HLG, 3 gamma-encoded BT.2020): to linear light with 1.0 = SDR white (203 nits), from
+// BT.2020 to BT.709 primaries, highlights compressed for an SDR target, encoded again.
+fn surface_to_sdr(encoded: vec3<f32>, transfer: u32) -> vec3<f32> {
+    let e = saturate(encoded);
+    var light = vec3<f32>(0.0);
+    if (transfer == 1u) {
+        // SMPTE ST 2084's EOTF: 1.0 is 10000 nits.
+        let p = pow(e, vec3<f32>(1.0 / 78.84375));
+        let nits = 10000.0 * pow(max(p - 0.8359375, vec3<f32>(0.0)) / (18.8515625 - 18.6875 * p), vec3<f32>(1.0 / 0.1593017578125));
+        light = nits / 203.0;
+    } else if (transfer == 2u) {
+        // ARIB STD-B67's inverse OETF, then the OOTF of a 1000-nit display (gamma 1.2).
+        let low = e * e / 3.0;
+        let high = (exp((e - 0.55991073) / 0.17883277) + 0.28466892) / 12.0;
+        let scene = select(high, low, e <= vec3<f32>(0.5));
+        let luminance = dot(scene, vec3<f32>(0.2627, 0.6780, 0.0593));
+        light = scene * pow(max(luminance, 1e-6), 0.2) * (1000.0 / 203.0);
+    } else {
+        light = pow(e, vec3<f32>(2.4));
+    }
+    var rgb = vec3<f32>(
+        dot(vec3<f32>(1.6605, -0.5876, -0.0728), light),
+        dot(vec3<f32>(-0.1246, 1.1329, -0.0083), light),
+        dot(vec3<f32>(-0.0182, -0.1006, 1.1187), light));
+    if (transfer == 3u) {
+        return pow(saturate(rgb), vec3<f32>(1.0 / 2.4));
+    }
+    // The curve Chromium uses for HDR on an SDR screen: x (1 + x / peak^2) / (1 + x) on the
+    // largest channel, the peak taken as 1000 nits.
+    let peak = 1000.0 / 203.0;
+    let largest = max(max(rgb.r, rgb.g), max(rgb.b, 1e-6));
+    rgb = saturate(rgb * ((1.0 + largest / (peak * peak)) / (1.0 + largest)));
+    // sRGB's encoding.
+    return select(1.055 * pow(rgb, vec3<f32>(1.0 / 2.4)) - 0.055, rgb * 12.92, rgb <= vec3<f32>(0.0031308));
+}
