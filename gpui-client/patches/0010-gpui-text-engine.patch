+    /// Shapes one line (no `\n`) with the platform's shaper and returns the result as is:
+    /// no cache is read or written, nothing is retained. For callers that keep their own
+    /// layouts (a `WindowTextSystem` caches per window and per frame).
+    pub fn shape_line_uncached(&self, text: &str, font_size: Pixels, runs: &[FontRun]) -> LineLayout {
+        self.platform_text_system.layout_line(text, font_size, runs)
+    }
+
+    /// The advance of a glyph in its font, without kerning, at `font_size`.
+    pub fn glyph_advance(&self, font_id: FontId, glyph_id: GlyphId, font_size: Pixels) -> Result<Pixels> {
+        let advance = self.platform_text_system.advance(font_id, glyph_id)?.width
+            / self.units_per_em(font_id) as f32;
+        Ok(font_size * advance)
+    }
+
+    /// The glyph the font draws `character` with, if it has one.
+    pub fn glyph_for_char(&self, font_id: FontId, character: char) -> Option<GlyphId> {
+        self.platform_text_system.glyph_for_char(font_id, character)
+    }
+
+    /// The font's metrics, in font units.
+    pub fn font_metrics(&self, font_id: FontId) -> FontMetrics {
+        self.read_metrics(font_id, |metrics| *metrics)
+    }
