+    /// `font_id` itself when the matched face has the requested slant and weight, else the
+    /// `FontId` that draws the same face with what is missing synthesised.
+    fn synthetic_twin(&mut self, font_id: FontId, request: &Font, font: FontKey) -> Result<FontId> {
+        let loaded = self.loaded_font(font_id);
+        if loaded.is_known_emoji_font {
+            return Ok(font_id);
+        }
+        let database_id = loaded.font.id();
+        let face = self
+            .font_system
+            .db()
+            .face(database_id)
+            .context("font face not found in database")?;
+        let synthetic = SyntheticStyle {
+            oblique: request.style != gpui::FontStyle::Normal
+                && face.style == cosmic_text::Style::Normal,
+            bold: request.weight.0 >= SyntheticStyle::BOLD_THRESHOLD
+                && f32::from(face.weight.0) < SyntheticStyle::BOLD_THRESHOLD,
+        };
+        if synthetic.is_none() {
+            return Ok(font_id);
+        }
+        let key = LoadedFontKey {
+            database_id,
+            font,
+            synthetic,
+        };
+        if let Some(&twin) = self.loaded_font_ids_by_key.get(&key) {
+            return Ok(twin);
+        }
+        let loaded = self.loaded_font(font_id);
+        let twin = LoadedFont {
+            font: loaded.font.clone(),
+            features: loaded.features.clone(),
+            is_known_emoji_font: false,
+            synthetic,
+            user_fallback_chain: Arc::clone(&loaded.user_fallback_chain),
+        };
+        let twin_id = FontId(self.loaded_fonts.len());
+        self.loaded_fonts.push(twin);
+        self.loaded_font_ids_by_key.insert(key, twin_id);
+        Ok(twin_id)
+    }
