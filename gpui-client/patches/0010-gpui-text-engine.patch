+/// Styles the rasteriser makes up because the family has no face for them, as Chromium does
+/// (CSS `font-synthesis`): a slant for an italic request answered by an upright face, extra
+/// weight for a request of 600 or more answered by a face lighter than 600. A face drawn this
+/// way is its own `FontId`, so glyph caches keyed by `FontId` keep the two apart; shaping and
+/// advances are the upright face's.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
+struct SyntheticStyle {
+    oblique: bool,
+    bold: bool,
+}
+
+impl SyntheticStyle {
+    /// Skia's `SK_Scalar1 / 4`, the skew Blink sets on a font with a synthetic italic
+    /// (`FontPlatformData::SetupSkFont`): x moves right by a quarter of the height.
+    const OBLIQUE_SKEW: f32 = 0.25;
+    /// FreeType's synthetic emboldening, which Skia uses on Linux: the outline grows by 1/24 em.
+    const BOLD_EM_FRACTION: f32 = 1.0 / 24.0;
+    /// CSS's `bolder` threshold: synthesis happens at or above it.
+    const BOLD_THRESHOLD: f32 = 600.0;
+
+    fn is_none(self) -> bool {
+        !self.oblique && !self.bold
+    }
 }
 
