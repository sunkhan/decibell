+/// Whether a window wants a frame request at the next vertical blank. The vsync thread takes
+/// it each turn: set, it waits for the blank and invalidates the windows (`WM_PAINT` is their
+/// frame request); unset, it parks until [`request_vsync`]. Starts set, for the first frame.
+static FRAME_DEMAND: AtomicBool = AtomicBool::new(true);
+/// The vsync thread is parked (or about to park): `request_vsync` must unpark it.
+static VSYNC_PARKED: AtomicBool = AtomicBool::new(false);
+static VSYNC_THREAD: parking_lot::Mutex<Option<std::thread::Thread>> =
+    parking_lot::Mutex::new(None);
+
+/// Asks for a frame request at the next vertical blank, from any thread. This is what keeps
+/// the vsync thread running: without a call per blank it parks, and a window with nothing to
+/// draw then costs no wakeup at all (neither the thread's nor the `WM_PAINT` it posts).
+pub(crate) fn request_vsync() {
+    FRAME_DEMAND.store(true, Ordering::SeqCst);
+    if VSYNC_PARKED.load(Ordering::SeqCst)
+        && let Some(thread) = VSYNC_THREAD.lock().as_ref()
+    {
+        thread.unpark();
+    }
+}
+
+/// Called by the vsync thread when it starts.
+pub(crate) fn register_vsync_thread() {
+    *VSYNC_THREAD.lock() = Some(std::thread::current());
+    FRAME_DEMAND.store(true, Ordering::SeqCst);
+}
+
+/// Called by the vsync thread at the top of each turn. Returns once a frame was asked for
+/// since the last turn, sleeping until then if none was. A return is not a promise of demand
+/// when `stop` is set (the caller checks it).
+pub(crate) fn wait_for_frame_demand(stop: &AtomicBool) {
+    while !FRAME_DEMAND.swap(false, Ordering::SeqCst) {
+        if stop.load(Ordering::Acquire) {
+            return;
+        }
+        VSYNC_PARKED.store(true, Ordering::SeqCst);
+        // Checked again after raising the flag: a request made before the flag was visible
+        // did not unpark, but its demand is; one made after it unparks (the token is kept if
+        // we are not parked yet).
+        if !FRAME_DEMAND.load(Ordering::SeqCst) && !stop.load(Ordering::Acquire) {
+            std::thread::park();
+        }
+        VSYNC_PARKED.store(false, Ordering::SeqCst);
+    }
+}
+
 const VSYNC_INTERVAL_THRESHOLD: Duration = Duration::from_millis(1);
 const DEFAULT_VSYNC_INTERVAL: Duration = Duration::from_micros(16_666); // ~60Hz
 
