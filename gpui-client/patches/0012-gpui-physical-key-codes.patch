+/// Decibell patch 0012: a modifier key went down or up. `XkbStateNotify` reports the new
+/// modifier state (only when it changed, and in no fixed order with the key event); this
+/// says which physical key moved, with the state as last reported.
+fn modifier_key_input(state: &X11ClientState, keycode: u8, pressed: bool) -> PlatformInput {
+    PlatformInput::ModifiersChanged(ModifiersChangedEvent {
+        modifiers: state.last_modifiers_changed_event,
+        capslock: state.last_capslock_changed_event,
+        key: Some(gpui::ModifierKey {
+            code: evdev_code(keycode),
+            pressed,
+        }),
+    })
+}
