+/// Decibell patch 0012: the physical key of an X11 key event. X11 keycodes are the kernel's
+/// evdev codes plus 8.
+fn evdev_code(keycode: u8) -> gpui::KeyCode {
+    match keycode.checked_sub(8) {
+        Some(code) => gpui::KeyCode::Evdev(code as u16),
+        None => gpui::KeyCode::Unknown,
+    }
+}
