+/// What `surface_vertex` / `surface_fragment` read from constant buffer 2. Field for field the
+/// `SurfaceParams` of `shaders.hlsl` (HLSL packs these `float4`-sized members without padding).
+#[derive(Clone, Copy, Debug, Default)]
+#[repr(C)]
+struct SurfaceParams {
+    /// Where the picture goes: the painted bounds, fitted.
+    bounds: [f32; 4],
+    content_mask: [f32; 4],
+    /// What the corner radii round: the bounds the element painted.
+    clip_bounds: [f32; 4],
+    corner_radii: [f32; 4],
+    /// Rows of the matrix taking (Y', Cb, Cr, 1) to gamma-encoded R'G'B'.
+    ycbcr_to_rgb: [[f32; 4]; 3],
+    /// The part of the texture shown in `bounds`: origin and size in texture coordinates.
+    uv_rect: [f32; 4],
+    /// Offset of the chroma samples, in texture coordinates.
+    chroma_offset: [f32; 2],
+    /// The luma texture's size in texels.
+    texture_size: [f32; 2],
+}
+
+/// Where a picture of `picture` pixels goes in `bounds` (origin and size in device pixels) and
+/// which part of it is shown (origin and size, as fractions of the picture): the fitted bounds,
+/// snapped to whole pixels, and the picture rectangle.
+fn fit_surface(bounds: [f32; 4], picture: [f32; 2], fit: SurfaceFit) -> ([f32; 4], [f32; 4]) {
+    let [x, y, width, height] = bounds;
+    if width <= 0.0 || height <= 0.0 {
+        return (bounds, [0.0, 0.0, 1.0, 1.0]);
+    }
+    let scale = [width / picture[0], height / picture[1]];
+    match fit {
+        SurfaceFit::Fill => (bounds, [0.0, 0.0, 1.0, 1.0]),
+        SurfaceFit::Contain => {
+            let scale = scale[0].min(scale[1]);
+            let size = [
+                (picture[0] * scale).round().clamp(1.0, width),
+                (picture[1] * scale).round().clamp(1.0, height),
+            ];
+            (
+                [
+                    x + ((width - size[0]) / 2.0).round(),
+                    y + ((height - size[1]) / 2.0).round(),
+                    size[0],
+                    size[1],
+                ],
+                [0.0, 0.0, 1.0, 1.0],
+            )
+        }
+        SurfaceFit::Cover => {
+            let scale = scale[0].max(scale[1]);
+            let shown = [
+                (width / (picture[0] * scale)).min(1.0),
+                (height / (picture[1] * scale)).min(1.0),
+            ];
+            (
+                bounds,
+                [
+                    (1.0 - shown[0]) / 2.0,
+                    (1.0 - shown[1]) / 2.0,
+                    shown[0],
+                    shown[1],
+                ],
+            )
+        }
+    }
+}
+
+/// Draws application-owned pictures (`directx_surface.rs`): two plane textures per picture,
+/// Y'CbCr to R'G'B' in the fragment shader.
+struct SurfacePipeline {
+    vertex: ID3D11VertexShader,
+    fragment: ID3D11PixelShader,
+    blend_state: ID3D11BlendState,
+    depth_stencil_state: ID3D11DepthStencilState,
+    params_buffer: Option<ID3D11Buffer>,
+    /// Linear, clamped at the picture's edge (the sprite sampler wraps).
+    sampler: Option<ID3D11SamplerState>,
+}
+
+impl SurfacePipeline {
+    /// The constant buffer slot of `SurfaceParams`, and the first of the two texture slots
+    /// (luma, then chroma) and the sampler slot the surface shaders read. Slots no other
+    /// pipeline of this renderer uses, so that nothing else has to be bound again afterwards.
+    const PARAMS_SLOT: u32 = 2;
+    const TEXTURE_SLOT: u32 = 4;
+    const SAMPLER_SLOT: u32 = 1;
+
+    fn new(device: &ID3D11Device) -> Result<Self> {
+        let vertex = {
+            let raw_shader = RawShaderBytes::new(ShaderModule::Surface, ShaderTarget::Vertex)?;
+            create_vertex_shader(device, raw_shader.as_bytes())?
+        };
+        let fragment = {
+            let raw_shader = RawShaderBytes::new(ShaderModule::Surface, ShaderTarget::Fragment)?;
+            create_fragment_shader(device, raw_shader.as_bytes())?
+        };
+        let sampler = unsafe {
+            let desc = D3D11_SAMPLER_DESC {
+                Filter: D3D11_FILTER_MIN_MAG_MIP_LINEAR,
+                AddressU: D3D11_TEXTURE_ADDRESS_CLAMP,
+                AddressV: D3D11_TEXTURE_ADDRESS_CLAMP,
+                AddressW: D3D11_TEXTURE_ADDRESS_CLAMP,
+                MipLODBias: 0.0,
+                MaxAnisotropy: 1,
+                ComparisonFunc: D3D11_COMPARISON_ALWAYS,
+                BorderColor: [0.0; 4],
+                MinLOD: 0.0,
+                MaxLOD: D3D11_FLOAT32_MAX,
+            };
+            let mut output = None;
+            device.CreateSamplerState(&desc, Some(&mut output))?;
+            output
+        };
+        Ok(Self {
+            vertex,
+            fragment,
+            blend_state: create_blend_state(device)?,
+            depth_stencil_state: create_depth_stencil_state(device, D3D11_DEPTH_WRITE_MASK_ZERO)?,
+            params_buffer: create_constant_buffer::<SurfaceParams>(device)?,
+            sampler,
+        })
+    }
+
+    fn draw(
+        &self,
+        device_context: &ID3D11DeviceContext,
+        surface: &PaintSurface,
+        frame: &D3d11SurfaceFrame,
+        fit: SurfaceFit,
+    ) -> Result<()> {
+        let planes = &frame.planes;
+        let picture = [planes.size.0.max(1) as f32, planes.size.1.max(1) as f32];
+        let texture = [
+            planes.texture_size.0.max(planes.size.0).max(1) as f32,
+            planes.texture_size.1.max(planes.size.1).max(1) as f32,
+        ];
+        let painted = [
+            surface.bounds.origin.x.0,
+            surface.bounds.origin.y.0,
+            surface.bounds.size.width.0,
+            surface.bounds.size.height.0,
+        ];
+        let (bounds, shown) = fit_surface(painted, picture, fit);
+        // From fractions of the picture to texture coordinates (the picture is the texture's
+        // top-left part).
+        let picture_in_texture = [picture[0] / texture[0], picture[1] / texture[1]];
+        let mask = &surface.content_mask.bounds;
+        let radii = &surface.corner_radii;
+        // The chroma plane has half the luma plane's texels.
+        let chroma_texels = [(texture[0] / 2.0).max(1.0), (texture[1] / 2.0).max(1.0)];
+        let params = SurfaceParams {
+            bounds,
+            content_mask: [
+                mask.origin.x.0,
+                mask.origin.y.0,
+                mask.size.width.0,
+                mask.size.height.0,
+            ],
+            clip_bounds: painted,
+            corner_radii: [
+                radii.top_left.0,
+                radii.top_right.0,
+                radii.bottom_right.0,
+                radii.bottom_left.0,
+            ],
+            ycbcr_to_rgb: frame.color.ycbcr_to_rgb_rows(),
+            uv_rect: [
+                shown[0] * picture_in_texture[0],
+                shown[1] * picture_in_texture[1],
+                shown[2] * picture_in_texture[0],
+                shown[3] * picture_in_texture[1],
+            ],
+            chroma_offset: [
+                frame.color.chroma_offset[0] / chroma_texels[0],
+                frame.color.chroma_offset[1] / chroma_texels[1],
+            ],
+            texture_size: texture,
+        };
+        let params_buffer = self
+            .params_buffer
+            .as_ref()
+            .context("surface params buffer missing")?;
+        update_buffer(device_context, params_buffer, &[params])?;
+        let textures = [Some(planes.luma.clone()), Some(planes.chroma.clone())];
+        unsafe {
+            device_context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+            device_context.VSSetShader(&self.vertex, None);
+            device_context.PSSetShader(&self.fragment, None);
+            device_context.OMSetBlendState(&self.blend_state, None, 0xFFFFFFFF);
+            device_context.OMSetDepthStencilState(&self.depth_stencil_state, 0);
+            device_context.VSSetConstantBuffers(
+                Self::PARAMS_SLOT,
+                Some(slice::from_ref(&self.params_buffer)),
+            );
+            device_context.PSSetConstantBuffers(
+                Self::PARAMS_SLOT,
+                Some(slice::from_ref(&self.params_buffer)),
+            );
+            device_context
+                .PSSetSamplers(Self::SAMPLER_SLOT, Some(slice::from_ref(&self.sampler)));
+            device_context.PSSetShaderResources(Self::TEXTURE_SLOT, Some(&textures));
+            device_context.Draw(4, 0);
+        }
+        Ok(())
+    }
+
+    /// Lets go of the pictures: a view bound to the context keeps its texture alive.
+    fn unbind(&self, device_context: &ID3D11DeviceContext) {
+        let none: [Option<ID3D11ShaderResourceView>; 2] = [None, None];
+        unsafe { device_context.PSSetShaderResources(Self::TEXTURE_SLOT, Some(&none)) };
+    }
+}
