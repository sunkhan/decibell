+
+/*
+**
+**              Surfaces: pictures the application owns (video), two plane textures each
+**
+*/
+
+// One surface per draw. Field for field `SurfaceParams` in directx_renderer.rs.
+cbuffer SurfaceParams: register(b2) {
+    // Where the picture goes: the painted bounds, fitted.
+    Bounds surface_bounds;
+    Bounds surface_content_mask;
+    // What the corner radii round: the bounds the element painted.
+    Bounds surface_clip_bounds;
+    Corners surface_corner_radii;
+    // Rows of the matrix taking (Y', Cb, Cr, 1) to gamma-encoded R'G'B'.
+    float4 surface_ycbcr_to_r;
+    float4 surface_ycbcr_to_g;
+    float4 surface_ycbcr_to_b;
+    // The part of the texture shown in the bounds: origin and size in texture coordinates.
+    float4 surface_uv_rect;
+    // Offset of the chroma samples, in texture coordinates.
+    float2 surface_chroma_offset;
+    // The luma texture's size in texels.
+    float2 surface_texture_size;
+};
+
+Texture2D<float4> t_surface_y: register(t4);
+Texture2D<float4> t_surface_cb_cr: register(t5);
+SamplerState s_surface: register(s1);
+
+struct SurfaceFragmentInput {
+    float4 position: SV_Position;
+    float2 texture_position: TEXCOORD0;
+};
+
+SurfaceFragmentInput surface_vertex(uint vertex_id: SV_VertexID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    ClippedVertex vertex = clip_to_mask(unit_vertex, surface_bounds, surface_content_mask);
+
+    SurfaceFragmentInput output;
+    output.position = to_device_position_impl(vertex.position);
+    // `surface_uv_rect` of the texture is shown in the unclipped bounds.
+    output.texture_position = surface_uv_rect.xy + vertex.unit_vertex * surface_uv_rect.zw;
+    return output;
+}
+
+float4 surface_fragment(SurfaceFragmentInput input): SV_Target {
+    // One output pixel covers `footprint` of the texture. Bilinear sampling is right up to two
+    // texels per pixel; a picture drawn smaller than that (a 1440p stream in a 320 px tile)
+    // would alias, so the footprint is averaged over a grid of up to 4x4 bilinear taps (8x8
+    // texels). At full size and above this is one tap.
+    float2 footprint = surface_uv_rect.zw / max(surface_bounds.size, float2(1.0, 1.0));
+    float2 texels = footprint * surface_texture_size;
+    int2 taps = int2(clamp(ceil(texels * 0.5), float2(1.0, 1.0), float2(4.0, 4.0)));
+    // The picture is the texture's top-left part: never sample past its last texel centre.
+    float2 uv_min = surface_uv_rect.xy + 0.5 / surface_texture_size;
+    float2 uv_max = surface_uv_rect.xy + surface_uv_rect.zw - 0.5 / surface_texture_size;
+    float3 sum = float3(0.0, 0.0, 0.0);
+    for (int j = 0; j < 4; j++) {
+        for (int i = 0; i < 4; i++) {
+            if (i < taps.x && j < taps.y) {
+                float2 offset = (float2(float(i), float(j)) + 0.5) / float2(taps) - 0.5;
+                float2 position = clamp(input.texture_position + offset * footprint, uv_min, uv_max);
+                sum += float3(
+                    t_surface_y.SampleLevel(s_surface, position, 0.0).r,
+                    t_surface_cb_cr.SampleLevel(s_surface, position + surface_chroma_offset, 0.0).rg);
+            }
+        }
+    }
+    float4 y_cb_cr = float4(sum / float(taps.x * taps.y), 1.0);
+    // The targets hold gamma-encoded colour, and so does video: no transfer function here.
+    float3 rgb = saturate(float3(
+        dot(surface_ycbcr_to_r, y_cb_cr),
+        dot(surface_ycbcr_to_g, y_cb_cr),
+        dot(surface_ycbcr_to_b, y_cb_cr)));
+    float distance = quad_sdf(input.position.xy, surface_clip_bounds, surface_corner_radii);
+    return float4(rgb, saturate(0.5 - distance));
+}
