diff --git a/crates/gpui_windows/src/directx_surface.rs b/crates/gpui_windows/src/directx_surface.rs
new file mode 100644
index 0000000..c990326
--- /dev/null
+++ b/crates/gpui_windows/src/directx_surface.rs
@@ -0,0 +1,303 @@
+//! Images the application owns on the GPU, drawn by the Direct3D 11 renderer as scene surfaces:
+//! the Direct3D twin of `gpui_wgpu`'s `wgpu_surface.rs`, with the same shape.
+//!
+//! An element paints a [`D3d11Surface`] (wrapped in a `gpui::ExternalSurface`) with
+//! `Window::paint_external_surface`. The application hands the surface new pictures from any
+//! thread with [`D3d11Surface::set_frame`]; the renderer takes the newest one each time it
+//! draws the scene, so a new picture costs a present of the retained scene
+//! (`Window::request_present`) and no layout or paint.
+//!
+//! The pictures live on the renderer's own device ([`shared_devices`]). That device is created
+//! with multithread protection on, so its immediate context may be used from other threads;
+//! [`D3d11ContextGuard`] holds the context across a sequence of calls.
+
+use parking_lot::Mutex;
+use std::any::Any;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use windows::Win32::Graphics::{
+    Direct3D11::{
+        ID3D11Device, ID3D11DeviceContext, ID3D11Multithread, ID3D11ShaderResourceView,
+    },
+    Dxgi::IDXGIAdapter1,
+};
+use windows::core::Interface;
+
+/// The device every window of this process renders with, and its immediate context.
+#[derive(Clone)]
+pub struct D3d11Devices {
+    pub adapter: IDXGIAdapter1,
+    pub device: ID3D11Device,
+    /// The immediate context. Multithread-protected: a single call is safe from any thread, a
+    /// sequence that must not be interleaved with the renderer's frame (or that leaves state
+    /// behind, such as a `Map`) is made under a [`D3d11ContextGuard`].
+    pub context: ID3D11DeviceContext,
+}
+
+impl D3d11Devices {
+    /// Whether Direct3D has removed the device (driver update, GPU reset, adapter unplugged).
+    /// The renderer notices at its next frame and creates another; [`shared_devices`] then
+    /// returns that one.
+    pub fn removed(&self) -> bool {
+        // Safety: a method of the free-threaded device object.
+        unsafe { self.device.GetDeviceRemovedReason() }.is_err()
+    }
+
+    /// Holds the immediate context until the guard is dropped (recursive on one thread).
+    /// `None`: the device has no multithread interface (not seen on Windows 10 or later).
+    pub fn lock_context(&self) -> Option<D3d11ContextGuard> {
+        D3d11ContextGuard::enter(&self.context)
+    }
+}
+
+/// The immediate context's own critical section, entered. The renderer holds it around each
+/// frame it draws; FFmpeg's D3D11VA decoders hold it around each decode submission when the
+/// application points their lock callbacks at `ID3D11Multithread::Enter` / `Leave`.
+pub struct D3d11ContextGuard(ID3D11Multithread);
+
+impl D3d11ContextGuard {
+    pub(crate) fn enter(context: &ID3D11DeviceContext) -> Option<Self> {
+        let multithread: ID3D11Multithread = context.cast().ok()?;
+        // Safety: paired with `Leave` in `Drop`, on the same thread (the guard is not `Send`:
+        // it holds no `Send` bound of its own, see the marker below).
+        unsafe { multithread.Enter() };
+        Some(Self(multithread))
+    }
+}
+
+impl Drop for D3d11ContextGuard {
+    fn drop(&mut self) {
+        // Safety: this thread entered the critical section in `enter`.
+        unsafe { self.0.Leave() };
+    }
+}
+
+static SHARED_DEVICES: Mutex<Option<D3d11Devices>> = Mutex::new(None);
+static SIMULATED_DEVICE_LOSS: AtomicBool = AtomicBool::new(false);
+
+/// The Direct3D 11 device every window of this process renders with: the device to create
+/// textures on for content handed to the renderer as a [`D3d11Surface`]. `None` until the
+/// platform has started windowed. A device removal replaces it (compare `device`).
+pub fn shared_devices() -> Option<D3d11Devices> {
+    SHARED_DEVICES.lock().clone()
+}
+
+pub(crate) fn set_shared_devices(devices: Option<D3d11Devices>) {
+    *SHARED_DEVICES.lock() = devices;
+}
+
+/// Makes the platform abandon its device and create another at the next vertical blank,
+/// exactly as after a real device removal. For testing what an application built on the
+/// device does when it is replaced. The caller then asks a window for a frame
+/// (`Window::request_present`) so that the vsync thread runs.
+pub fn simulate_device_loss() {
+    log::warn!("Direct3D device marked lost on request");
+    SIMULATED_DEVICE_LOSS.store(true, Ordering::Release);
+}
+
+pub(crate) fn take_simulated_device_loss() -> bool {
+    SIMULATED_DEVICE_LOSS.swap(false, Ordering::AcqRel)
+}
+
+/// The two plane views of a 4:2:0 picture, on the renderer's device: luma (one channel) and
+/// interleaved chroma (two channels, half size). Views of an `NV12` texture's planes
+/// (`R8_UNORM` and `R8G8_UNORM` views of it) or of ordinary `R8` / `R8G8` textures.
+///
+/// Long-lived: a decoder cycles through a small fixed set of these.
+pub struct D3d11SurfacePlanes {
+    pub luma: ID3D11ShaderResourceView,
+    pub chroma: ID3D11ShaderResourceView,
+    /// The picture's size in pixels.
+    pub size: (u32, u32),
+    /// The luma texture's size: the picture is its top-left part (an `NV12` texture has even
+    /// dimensions, a picture need not).
+    pub texture_size: (u32, u32),
+}
+
+/// How a picture's Y'CbCr samples become R'G'B'.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SurfaceMatrix {
+    Bt601,
+    Bt709,
+    Bt2020,
+}
+
+/// A picture's colour description.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SurfaceColor {
+    pub matrix: SurfaceMatrix,
+    /// Full range (0..255) rather than limited (16..235 / 16..240).
+    pub full_range: bool,
+    /// Added to the chroma sampling position, in chroma texels. [0.0, 0.0] is right for chroma
+    /// sited at the centre of each 2x2 luma block (what sampling both planes at the same
+    /// coordinate assumes); "left" siting, the H.264 / HEVC / AV1 default, is [0.25, 0.0].
+    pub chroma_offset: [f32; 2],
+}
+
+impl Default for SurfaceColor {
+    fn default() -> Self {
+        Self {
+            matrix: SurfaceMatrix::Bt709,
+            full_range: false,
+            chroma_offset: [0.0, 0.0],
+        }
+    }
+}
+
+impl SurfaceColor {
+    /// Rows of the matrix taking (Y', Cb, Cr, 1) as sampled (0..1) to gamma-encoded R'G'B'.
+    /// GPUI's targets hold gamma-encoded colour, so the result is written as is.
+    pub fn ycbcr_to_rgb_rows(&self) -> [[f32; 4]; 3] {
+        let (kr, kb) = match self.matrix {
+            SurfaceMatrix::Bt601 => (0.299, 0.114),
+            SurfaceMatrix::Bt709 => (0.2126, 0.0722),
+            SurfaceMatrix::Bt2020 => (0.2627, 0.0593),
+        };
+        let kg = 1.0 - kr - kb;
+        // Scale and offset from the stored code values to Y' in 0..1 and Cb / Cr in -0.5..0.5.
+        let (y_scale, y_offset, c_scale) = if self.full_range {
+            (1.0f32, 0.0f32, 1.0f32)
+        } else {
+            (255.0 / 219.0, 16.0 / 255.0, 255.0 / 224.0)
+        };
+        let c_offset = 128.0 / 255.0;
+        let r_cr = 2.0 * (1.0 - kr);
+        let b_cb = 2.0 * (1.0 - kb);
+        let g_cb = -b_cb * kb / kg;
+        let g_cr = -r_cr * kr / kg;
+        let row = |cb: f32, cr: f32| {
+            let cb = cb * c_scale;
+            let cr = cr * c_scale;
+            [
+                y_scale,
+                cb,
+                cr,
+                -y_scale * y_offset - (cb + cr) * c_offset,
+            ]
+        };
+        [row(0.0, r_cr), row(g_cb, g_cr), row(b_cb, 0.0)]
+    }
+}
+
+/// One picture, ready to be sampled: every write to its planes was issued on the immediate
+/// context before the frame was handed to [`D3d11Surface::set_frame`] (Direct3D 11 executes a
+/// context's commands in the order they were issued, so a draw issued later samples the
+/// finished picture).
+///
+/// A decoder that cycles through a fixed set of planes keeps one `Arc<D3d11SurfaceFrame>` per
+/// set and publishes it again and again: the set is free to be written when the decoder holds
+/// the only reference (`Arc::strong_count == 1`). The renderer holds its reference only while
+/// it issues the draws of a frame; a write issued after that is executed after them.
+pub struct D3d11SurfaceFrame {
+    pub planes: Arc<D3d11SurfacePlanes>,
+    pub color: SurfaceColor,
+    /// The device the planes live on. A renderer on another device (the one created after a
+    /// device removal) draws nothing for this picture.
+    pub device: ID3D11Device,
+    /// Dropped with the frame. For owners that make a frame per picture.
+    pub in_use: Option<Box<dyn Any + Send + Sync>>,
+}
+
+/// How a picture is placed in the bounds an element painted (CSS `object-fit`). The renderer
+/// applies it when it draws, from the size of the picture it draws: a stream that changes
+/// resolution keeps its fit without the element being painted again.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum SurfaceFit {
+    /// Stretch to the bounds.
+    #[default]
+    Fill,
+    /// The whole picture, centred, bars left over (the element paints what is behind them).
+    Contain,
+    /// Fill the bounds, cropping the picture's overflow equally on both sides.
+    Cover,
+}
+
+/// A [`D3d11Surface`] with a fit: what an element wraps in a `gpui::ExternalSurface` when it
+/// wants something other than [`SurfaceFit::Fill`]. Corner radii round the painted bounds (the
+/// element's box), not the fitted picture.
+pub struct D3d11SurfaceView {
+    pub surface: Arc<D3d11Surface>,
+    pub fit: SurfaceFit,
+}
+
+/// A place in the scene that shows the newest picture it was given.
+#[derive(Default)]
+pub struct D3d11Surface {
+    /// The newest picture, its sequence number (1-based count of pictures set) and the tag it
+    /// was set with.
+    latest: Mutex<(u64, u64, Option<Arc<D3d11SurfaceFrame>>)>,
+    last_drawn: AtomicU64,
+    pictures_drawn: AtomicU64,
+    draws: AtomicU64,
+    /// Called with a picture's tag the first time a rendered frame draws it.
+    observer: std::sync::OnceLock<Box<dyn Fn(u64) + Send + Sync>>,
+}
+
+impl D3d11Surface {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self::default())
+    }
+
+    /// Replaces the picture. Callable from any thread; the caller then asks the window that
+    /// shows the surface for a present (`Window::request_present`, on the main thread).
+    /// `tag` is the caller's own number for the picture, handed to the draw observer.
+    pub fn set_frame(&self, frame: Arc<D3d11SurfaceFrame>, tag: u64) {
+        let previous = {
+            let mut latest = self.latest.lock();
+            latest.0 += 1;
+            latest.1 = tag;
+            latest.2.replace(frame)
+        };
+        // Released outside the lock: the last reference frees GPU objects.
+        drop(previous);
+    }
+
+    /// Stops showing a picture (the surface draws nothing).
+    pub fn clear(&self) {
+        let previous = self.latest.lock().2.take();
+        drop(previous);
+    }
+
+    /// Installs the function called (on the render thread, with the picture's tag) the first
+    /// time a rendered frame draws each picture: the "presented" timestamp of a video frame.
+    /// It must be cheap and must not block. Once per surface; a second call returns false.
+    pub fn set_draw_observer(&self, observer: Box<dyn Fn(u64) + Send + Sync>) -> bool {
+        self.observer.set(observer).is_ok()
+    }
+
+    /// The size in pixels of the newest picture.
+    pub fn picture_size(&self) -> Option<(u32, u32)> {
+        let latest = self.latest.lock();
+        Some(latest.2.as_ref()?.planes.size)
+    }
+
+    /// How many distinct pictures reached a rendered frame.
+    pub fn pictures_drawn(&self) -> u64 {
+        self.pictures_drawn.load(Ordering::Relaxed)
+    }
+
+    /// How many rendered frames drew this surface (a picture drawn again counts again).
+    pub fn draws(&self) -> u64 {
+        self.draws.load(Ordering::Relaxed)
+    }
+
+    /// The picture to draw now. Called by the renderer once per surface per frame.
+    /// `None` when there is no picture or it lives on another device than `device`.
+    pub(crate) fn acquire(&self, device: &ID3D11Device) -> Option<Arc<D3d11SurfaceFrame>> {
+        let (sequence, tag, frame) = {
+            let latest = self.latest.lock();
+            (latest.0, latest.1, latest.2.clone()?)
+        };
+        if frame.device != *device {
+            return None;
+        }
+        self.draws.fetch_add(1, Ordering::Relaxed);
+        if self.last_drawn.swap(sequence, Ordering::Relaxed) != sequence {
+            self.pictures_drawn.fetch_add(1, Ordering::Relaxed);
+            if let Some(observer) = self.observer.get() {
+                observer(tag);
+            }
+        }
+        Some(frame)
+    }
+}
