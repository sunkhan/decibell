+    /// Hides the mouse cursor until the mouse next moves, as typing does under
+    /// [`App::set_cursor_hide_mode`]: for an application that hides the cursor by
+    /// a rule of its own (a video shown full screen, once the pointer has rested).
+    /// The platform shows it again on the next pointer motion; nothing is hidden
+    /// while the pointer is over none of the application's windows.
+    pub fn hide_cursor_until_mouse_moves(&self) {
+        self.platform.hide_cursor_until_mouse_moves();
+    }
