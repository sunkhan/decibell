+
+/// Where a picture of `picture` pixels goes in `bounds` (device pixels) and which part of it is
+/// shown: the fitted bounds, snapped to whole pixels, and the texture rectangle.
+fn fit_surface(bounds: PodBounds, picture: [f32; 2], fit: SurfaceFit) -> (PodBounds, [f32; 4]) {
+    let [width, height] = bounds.size;
+    if width <= 0.0 || height <= 0.0 {
+        return (bounds, [0.0, 0.0, 1.0, 1.0]);
+    }
+    let scale = [width / picture[0], height / picture[1]];
+    match fit {
+        SurfaceFit::Fill => (bounds, [0.0, 0.0, 1.0, 1.0]),
+        SurfaceFit::Contain => {
+            let scale = scale[0].min(scale[1]);
+            let size = [
+                (picture[0] * scale).round().clamp(1.0, width),
+                (picture[1] * scale).round().clamp(1.0, height),
+            ];
+            let origin = [
+                bounds.origin[0] + ((width - size[0]) / 2.0).round(),
+                bounds.origin[1] + ((height - size[1]) / 2.0).round(),
+            ];
+            (PodBounds { origin, size }, [0.0, 0.0, 1.0, 1.0])
+        }
+        SurfaceFit::Cover => {
+            let scale = scale[0].max(scale[1]);
+            let shown = [
+                (width / (picture[0] * scale)).min(1.0),
+                (height / (picture[1] * scale)).min(1.0),
+            ];
+            (
+                bounds,
+                [
+                    (1.0 - shown[0]) / 2.0,
+                    (1.0 - shown[1]) / 2.0,
+                    shown[0],
+                    shown[1],
+                ],
+            )
+        }
+    }
 }
 
