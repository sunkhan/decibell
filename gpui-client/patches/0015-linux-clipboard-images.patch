 /// Text mime types that we'll accept from other programs.
 pub(crate) const ALLOWED_TEXT_MIME_TYPES: [&str; 2] = ["text/plain;charset=utf-8", "UTF8_STRING"];
 
+/// The mime types `item` is offered under: the text ones when it has text, and each picture's
+/// own type (`image/png`, …), in the order of its entries.
+pub(crate) fn offered_mime_types(item: &ClipboardItem) -> Vec<&'static str> {
+    let mut types = Vec::new();
+    if item.text().is_some() {
+        types.extend(TEXT_MIME_TYPES);
+    }
+    for entry in item.entries() {
+        if let ClipboardEntry::Image(image) = entry {
+            let mime_type = image.format.mime_type();
+            if !types.contains(&mime_type) {
+                types.push(mime_type);
+            }
+        }
+    }
+    types
+}
+
+/// What another program gets when it asks `item` for `mime_type`: the text for a text type, a
+/// picture's bytes for its own type, else nothing.
+pub(crate) fn contents_for_mime_type(item: &ClipboardItem, mime_type: &str) -> Option<Vec<u8>> {
+    if TEXT_MIME_TYPES.contains(&mime_type) {
+        return item.text().map(String::into_bytes);
+    }
+    item.entries().iter().find_map(|entry| match entry {
+        ClipboardEntry::Image(image) if image.format.mime_type() == mime_type => {
+            Some(image.bytes.clone())
+        }
+        _ => None,
+    })
+}
